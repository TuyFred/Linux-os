# GROUP 2 OS kernel branding and boot support
# Merged on top of x86_64 defconfig. Does not replace the kernel.

CONFIG_DEFAULT_HOSTNAME="group2-os"
CONFIG_LOCALVERSION="-GROUP2-OS"
# CONFIG_LOCALVERSION_AUTO is not set

# Initramfs / early userspace
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_UNIX98_PTYS=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX=y
CONFIG_SHMEM=y
CONFIG_OVERLAY_FS=y

# Filesystems needed by GROUP 2 OS
CONFIG_EXT4_FS=y
CONFIG_ISO9660_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# Boot logo + framebuffer console (boot screen)
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# QEMU / virtual machine testing
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SCSI_VIRTIO=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_NET=y
CONFIG_INET=y

# Keep kernel identity inspectable
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
