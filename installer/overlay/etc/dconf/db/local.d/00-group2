[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/group2-os-desktop.png'
picture-uri-dark='file:///usr/share/backgrounds/group2-os-desktop.png'
picture-options='zoom'
primary-color='#071422'
secondary-color='#0a1a30'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/group2-os-login.png'
picture-options='zoom'
lock-enabled=true

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
accent-color='blue'
gtk-theme='Yaru-blue-dark'
icon-theme='Yaru-blue'
clock-format='24h'
clock-show-weekday=true
clock-show-date=true
clock-show-seconds=true

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'
theme='Yaru-blue-dark'

[org/gnome/shell]
favorite-apps=['group2-suite.desktop', 'group2-assistant.desktop', 'group2-install.desktop', 'group2-about.desktop', 'group2-appearance.desktop', 'group2-terminal.desktop', 'org.gnome.Terminal.desktop', 'firefox_firefox.desktop', 'firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Settings.desktop']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=true
autohide=false
dash-max-icon-size=42
show-trash=false
show-mounts=false
show-show-apps-button=true
show-apps-at-top=true
click-action='focus-minimize-or-previews'
transparency-mode='FIXED'
background-opacity=0.72
custom-background-color=true
background-color='rgb(10,26,48)'
custom-theme-shrink=true
disable-overview-on-startup=true

[org/gnome/shell/extensions/ding]
show-home=false
show-trash=false
show-volumes=false
show-network-volumes=false
icon-size='large'
keep-arranged=false

[org/gnome/nautilus/preferences]
default-folder-viewer='icon-view'
click-policy='single'

[org/gnome/desktop/lockdown]
disable-log-out=false
disable-user-switching=false

[org/gnome/nautilus/icon-view]
default-zoom-level='large'
