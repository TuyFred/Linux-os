[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/group2-os-desktop.png'
picture-uri-dark='file:///usr/share/backgrounds/group2-os-desktop.png'
picture-options='zoom'
primary-color='#071422'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/group2-os-login.png'
picture-options='zoom'

[org.gnome.desktop.lockdown]
disable-log-out=false
disable-user-switching=false

[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='blue'
gtk-theme='Yaru-blue-dark'
icon-theme='Yaru-blue'

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dash-max-icon-size=42
show-apps-at-top=true
transparency-mode='FIXED'
background-opacity=0.72
custom-background-color=true
background-color='rgb(10,26,48)'
